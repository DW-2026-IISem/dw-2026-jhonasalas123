@baseUrl = http://localhost:4000

### Iniciar sesión como administrador
# @name loginAdmin
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###

### Crear un registro de inventario
POST {{baseUrl}}/api/inventarios
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "ubicacion_id": 1,
  "item_id": 1,
  "cantidad": 20,
  "stock_minimo": 5
}
