@baseUrl = http://localhost:4000

### 1. Iniciar sesión como administrador
# @name loginAdmin
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###

### 2. Obtener todos los servicios de mascotas
GET {{baseUrl}}/api/servicios-mascota
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

###

### 3. Obtener un servicio por ID
GET {{baseUrl}}/api/servicios-mascota/1
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}
