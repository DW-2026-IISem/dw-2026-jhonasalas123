@baseUrl = http://localhost:4000

### Iniciar sesión como administrador
# @name loginAdmin
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###

### Crear un servicio para mascotas
POST {{baseUrl}}/api/servicios-mascota
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "nombre": "Servicio de prueba",
  "descripcion": "Servicio creado para probar la API",
  "isActive": true
}
