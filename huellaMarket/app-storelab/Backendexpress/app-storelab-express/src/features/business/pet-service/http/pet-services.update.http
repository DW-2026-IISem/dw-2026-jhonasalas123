@baseUrl = http://localhost:4000

### Iniciar sesión como administrador
# @name loginAdmin
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###

### Actualizar un servicio existente
PUT {{baseUrl}}/api/servicios-mascota/1
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "nombre": "Vacunación",
  "descripcion": "Servicio de vacunación actualizado",
  "isActive": true
}

###

### Actualizar parcialmente un servicio
PATCH {{baseUrl}}/api/servicios-mascota/1
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "descripcion": "Descripción actualizada"
}
