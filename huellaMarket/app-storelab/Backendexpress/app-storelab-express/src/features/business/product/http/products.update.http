@baseUrl = http://localhost:4000

### Iniciar sesión como administrador
# @name loginAdmin
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###

### Actualizar completamente un producto
PUT {{baseUrl}}/api/productos/1
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "sku": "HUE-PRUEBA-001",
  "nombre": "Alimento para mascotas actualizado",
  "descripcion": "Descripción actualizada",
  "precio": 28000,
  "isActive": true
}

###

### Actualizar parcialmente un producto
PATCH {{baseUrl}}/api/productos/1
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "precio": 27000
}
