@baseUrl = http://localhost:4000

### Iniciar sesión como administrador
# @name loginAdmin
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###

### Crear un producto
POST {{baseUrl}}/api/productos
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "sku": "HUE-PRUEBA-001",
  "nombre": "Alimento para mascotas de prueba",
  "descripcion": "Producto de prueba para HuellaMarket",
  "precio": 25000,
  "isActive": true
}
