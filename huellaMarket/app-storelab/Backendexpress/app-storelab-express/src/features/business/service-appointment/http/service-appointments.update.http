@baseUrl = http://localhost:4000

### Iniciar sesión como administrador
# @name loginAdmin
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###

### Actualizar una cita completa
PUT {{baseUrl}}/api/citas-servicio/1
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "nombre": "Jornada de vacunación actualizada",
  "descripcion": "Cita de vacunación para mascotas",
  "isActive": true
}

###

### Actualizar parcialmente una cita
PATCH {{baseUrl}}/api/citas-servicio/1
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "descripcion": "Cita para aplicación de vacunas"
}
