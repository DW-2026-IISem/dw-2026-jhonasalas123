@baseUrl = http://localhost:4000

### Iniciar sesión como administrador
# @name loginAdmin
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###

### Crear un detalle de venta
POST {{baseUrl}}/api/venta-detalles
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "cabecera_id": 1,
  "item_id": 1,
  "cantidad": 2,
  "valor_unitario": 12500,
  "total": 25000,
  "observaciones": "Detalle de prueba"
}
