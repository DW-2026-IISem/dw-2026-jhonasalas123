@baseUrl = http://localhost:4000

### Iniciar sesión como administrador
# @name loginAdmin
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###

### Actualizar completamente un proveedor
PUT {{baseUrl}}/api/proveedores/1
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "nit": "PRUEBA-HM-001",
  "razon_social": "Proveedor de prueba actualizado",
  "contacto": "Contacto actualizado",
  "telefono": "3001234567",
  "email": "proveedor.prueba@example.com",
  "isActive": true
}

###

### Actualizar parcialmente un proveedor
PATCH {{baseUrl}}/api/proveedores/1
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "telefono": "3101234567"
}
