@baseUrl = http://localhost:4000

### Iniciar sesión como administrador
# @name loginAdmin
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###

### Crear un proveedor
POST {{baseUrl}}/api/proveedores
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.access_token}}

{
  "nit": "PRUEBA-HM-001",
  "razon_social": "Proveedor de prueba HuellaMarket",
  "contacto": "Contacto de prueba",
  "telefono": "3001234567",
  "email": "proveedor.prueba@example.com",
  "isActive": true
}
